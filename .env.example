# Скопируйте в .env и заполните. Реальные секреты в репозиторий не коммитим.

# --- Postgres (контейнер postgres; DATABASE_URL для сервисов compose собирает сам) ---
POSTGRES_USER=buddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=buddy
# Нужен только при запуске Go-бинарей вне docker (go run ./cmd/...).
DATABASE_URL=postgres://buddy:change-me@localhost:5432/buddy?sslmode=disable

# --- Авторизация ---
# Не короче 32 байт.
JWT_SECRET=change-me-at-least-32-bytes-long-random-string
# Общий секрет api <-> agent (заголовок X-Agent-Key).
AGENT_KEY=change-me

# --- Порты и адреса сервисов ---
# Локальный порт по умолчанию; в compose у каждого сервиса свой PORT в environment.
PORT=8080
# Локально; в compose переопределяется на http://agent:8001.
AGENT_URL=http://localhost:8001
# Для агента; в compose — http://mcp-buddy:8090/mcp.
MCP_BUDDY_URL=http://localhost:8090/mcp

# --- Ollama / RAG ---
# Локальный адрес Ollama (go run). В compose используется OLLAMA_DOCKER_URL.
OLLAMA_URL=http://localhost:11434
# Адрес Ollama изнутри контейнеров (по умолчанию http://host.docker.internal:11434).
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
EMBEDDED_MODEL=nomic-embed-text
LLM_MODEL=llama3.1
# Путь к базе знаний для ingest вне docker; в compose — /data/knowledge.
KNOWLEDGE_PATH=data/knowledge
# Версия индекса для ingest в compose (меняйте при смене модели или чанкинга).
INDEX_VERSION=v1
