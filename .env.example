# Скопируйте в .env и заполните. Реальные секреты в репозиторий не коммитим.

# --- Postgres (контейнер postgres; DATABASE_URL для сервисов compose собирает сам) ---
POSTGRES_USER=buddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=buddy
# Нужен только при запуске Go-бинарей вне docker (go run ./cmd/...).
DATABASE_URL=postgres://buddy:change-me@localhost:5432/buddy?sslmode=disable

# --- Авторизация ---
# Не короче 32 байт.
JWT_SECRET=change-me-at-least-32-bytes-long-random-string
# Общий секрет api <-> agent (заголовок X-Agent-Key).
AGENT_KEY=change-me

# --- Порты и адреса сервисов ---
# Локальный порт по умолчанию; в compose у каждого сервиса свой PORT в environment.
PORT=8080
# Локально; в compose переопределяется на http://agent:8001.
AGENT_URL=http://localhost:8001
# Для агента; в compose — http://mcp-buddy:8090/mcp.
MCP_BUDDY_URL=http://localhost:8090/mcp
MCP_CORPORATE_URL=http://localhost:8091/mcp

# --- Ollama / RAG ---
# Локальный адрес Ollama (go run). В compose используется OLLAMA_DOCKER_URL.
OLLAMA_URL=http://localhost:11434
# Адрес для Go, Python и загрузчика моделей ВНУТРИ сети Compose.
OLLAMA_DOCKER_URL=http://ollama:11434
OLLAMA_IMAGE=ollama/ollama:latest
# Публикуется только на localhost; при занятом 11434 можно задать другой порт.
OLLAMA_PORT=11434
EMBEDDED_MODEL=qwen3-embedding:0.6b
LLM_MODEL=qwen3:4b-instruct
# Путь к базе знаний для ingest вне docker; в compose — /data/knowledge.
KNOWLEDGE_PATH=data/knowledge
# Версия индекса для ingest в compose (меняйте при смене модели или чанкинга).
INDEX_VERSION=qwen3-embedding-06b-v1

# Возможности памяти: текущий Go пока не реализует эти ручки.
HISTORY_SEARCH_ENABLED=false
SUMMARY_ENABLED=false

# Python agent (Compose подставляет AGENT_SERVICE_TOKEN из AGENT_KEY).
AGENT_MODE=go
WHOAMI_TOOL=whoami
OLLAMA_MODEL=qwen3:4b-instruct
CONTEXT_TOKENS=8192
OUTPUT_TOKENS=512
SAFETY_TOKENS=512
SUMMARY_CHARS=1600
MAX_STEPS=6
REQUEST_TIMEOUT=120
GUNICORN_CMD_ARGS='--bind=0.0.0.0:8001 --workers=1 --threads=4 --timeout=300 --graceful-timeout=30 --access-logfile=-'

# Публичный Go API, доступный БРАУЗЕРУ на HTML-странице /demo.
PUBLIC_GO_API_URL=http://localhost:8080

# Ограничение памяти локальной Ollama: одна модель и один запрос одновременно.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=8192
