# Скопируйте в .env.local при необходимости. Секретов здесь нет.

# api (по умолчанию) — настоящий Go API; mock — без сети, данные из src/api/mock.ts
VITE_API_MODE=api
# Куда dev-сервер Vite проксирует /api (Go API из docker compose)
VITE_API_URL=http://localhost:8080
# Тестовая учётка для входа (имитация SSO, см. backend/migrations/0003_initData.up.sql)
VITE_DEMO_LOGIN=sasha.intern
# Абсолютный адрес API для сборки без прокси; пусто — тот же адрес, что у фронта
VITE_API_BASE=
