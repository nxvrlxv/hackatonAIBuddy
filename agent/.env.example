# Скопировать в agent/.env. Значения ниже — примеры, а не настройки в Python-коде.
AGENT_MODE=go
AGENT_SERVICE_TOKEN=replace-with-a-shared-service-secret

# Имена будущих Go-сервисов в общей сети docker compose.
# Сейчас этих сервисов ещё нет в корневом Compose — бэкендер должен их добавить.
GO_API_URL=http://api:8080
MCP_URL=http://mcp-buddy:8000/mcp
WHOAMI_TOOL=whoami

# Диалоговая модель агента. Это НЕ модель эмбеддингов.
# host.docker.internal — Ollama на машине-хосте; для контейнера Ollama укажи имя сервиса.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct

CONTEXT_TOKENS=16384
OUTPUT_TOKENS=1024
SAFETY_TOKENS=1024
SUMMARY_CHARS=1600
MAX_STEPS=6
REQUEST_TIMEOUT=120

# Для demo в RAM оставь ровно один worker.
GUNICORN_CMD_ARGS='--bind=0.0.0.0:8001 --workers=1 --threads=4 --timeout=300 --graceful-timeout=30 --access-logfile=-'
