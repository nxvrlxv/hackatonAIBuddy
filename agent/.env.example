# Скопировать в agent/.env. Значения ниже — примеры, а не настройки в Python-коде.
AGENT_MODE=go
AGENT_SERVICE_TOKEN=replace-with-a-shared-service-secret

# Go-сервисы в общей сети Docker Compose.
GO_API_URL=http://api:8080
MCP_URL=http://mcp-buddy:8090/mcp
# Имитации корпоративных систем (отгулы). Пусто — всё идёт в MCP_URL.
MCP_CORPORATE_URL=http://mcp-corporate:8091/mcp
WHOAMI_TOOL=whoami

# Диалоговая модель агента. Это НЕ модель эмбеддингов.
# Для локального Flask/WSL: опубликованный порт Ollama.
# Compose сам подставляет http://ollama:11434 из OLLAMA_DOCKER_URL.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

CONTEXT_TOKENS=8192
OUTPUT_TOKENS=512
SAFETY_TOKENS=512
SUMMARY_CHARS=1600
MAX_STEPS=6
REQUEST_TIMEOUT=120

# Для demo в RAM оставь ровно один worker.
GUNICORN_CMD_ARGS='--bind=0.0.0.0:8001 --workers=1 --threads=4 --timeout=300 --graceful-timeout=30 --access-logfile=-'

# Возможности памяти: текущий Go пока не реализует эти ручки.
HISTORY_SEARCH_ENABLED=false
SUMMARY_ENABLED=false

# Публичный Go API, доступный БРАУЗЕРУ на HTML-странице /demo.
PUBLIC_GO_API_URL=http://localhost:8080
